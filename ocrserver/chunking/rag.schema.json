            },
            "overlap_candidates": {
              "const": 16
            }
          },
          "required": [
            "name",
            "max_reach",
            "max_candidates",
            "overlap_candidates"
          ],
          "additionalProperties": false
        },
        "unassigned_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnassignedSource"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        }
      },
      "required": [
        "titles",
        "scope",
        "chunking_options",
        "order_summary",
        "algorithm_profile",
        "unassigned_sources",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "Chunk": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "token_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "section_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:._-]+$"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "section_path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "block_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "minItems": 1
        },
        "context_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextSpan"
          }
        },
        "page_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PageContext"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        },
        "overflow": {
          "type": "boolean"
        },
        "overflow_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overflow_reason": {
          "enum": [
            "protected_table",
            "protected_code"
          ]
        },
        "overlap_token_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tokenizer": {
          "$ref": "#/$defs/Tokenizer"
        },
        "chunker_version": {
          "const": "structural-dp-v1.1"
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "document_context": {
          "$ref": "#/$defs/DocumentContext"
        }
      },
      "required": [
        "id",
        "text",
        "token_count"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["overflow"],
            "properties": {
              "overflow": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "overflow_reason"
            ],
            "properties": {
              "overflow_tokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "overlap_token_count": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "overflow_tokens": {
                "const": 0
              }
            },
            "not": {
              "required": [
                "overflow_reason"
              ]
            }
          }
        }
      ]
    }
  }
}
