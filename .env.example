# Smart Document Manager unified environment
# Copy this file to .env, configure the required values, then use stack.ps1 / stack.sh.
# Git ignores .env; this template must never contain real secrets.
# Compose reads .env, NOT .env.example; fallback values remain in compose.yml.
# Shell variables override .env. Timeouts are in seconds and limits in bytes
# unless stated otherwise. Leave GPU overrides empty for automatic selection.
# Configuration, precedence and security guide: guide/environment.html
#
# MINIMUM TO BOOT: an NVIDIA GPU with working host drivers, plus a decision on
# MCP authentication (section 03). Because MCP_SERVER_ENABLED=true by default
# and MCP refuses to start with an empty MCP_API_TOKENS list, either:
#   1. set MCP_API_TOKENS=<secret>:agent in section 03, or
#   2. start without MCP via `pwsh stack.ps1 up -NoMcp` / `bash stack.sh up --no-mcp`
#      (or set MCP_SERVER_ENABLED=false in section 01).
# Everything else has a working default -- including OCR API authentication,
# which ships DISABLED so the local web console works out of the box.
#
# READ SECTION 03 BEFORE THIS HOLDS ANYTHING YOU CARE ABOUT. As shipped,
# OCR_SERVER_API_TOKENS is empty, so ocr-api accepts every request on 127.0.0.1
# without a bearer token. Every published port stays bound to 127.0.0.1, so
# nothing outside this machine can reach the stack -- but every process and
# every user on this host can submit documents, read metrics, or query storage.
# Section 03 explains how to lock down both services with distinct credentials.
#
# CONVENTION: an uncommented assignment is the active template value; an empty
# uncommented assignment delegates to the calibrated hardware profile or the
# service's built-in default; a commented assignment (section 14) is a
# native-run override not forwarded by Compose.
#
# SECTIONS: 01 profiles & optional services / 02 published ports / 03 auth /
# 04 console, swagger & CORS / 05 API admission, memory, uploads, timeouts &
# rate limits / 06 PDF rasterization / 07 Office conversion / 08 autotune &
# pipeline concurrency / 09 vLLM runtime / 10 RAG chunking limits / 11 MCP
# server / 12 S3 archive / 13 S3 credentials / 14 native-run overrides.

# =============================================================================
# 01 | Compose profiles and optional services
# =============================================================================

# Optional Compose profile list. Empty starts the three core services: ocr-api,
# vllm-paddleocr and (unless disabled below) ocr-mcp. The only supported profile
# name is `storage`, which adds seaweedfs, storage-gateway and storage-init.
# Use `python scripts/configure_storage.py` to enable `storage` and generate
# the required credentials in sections 12 and 13 automatically.
COMPOSE_PROFILES=

# Read only by stack.ps1 / stack.sh, never by a container. When false, the
# launcher omits ocr-mcp from build/up, stops and removes any leftover ocr-mcp
# container, and skips MCP_API_TOKENS validation in verify_token_config.py.
# Running `docker compose up` directly ignores this switch.
MCP_SERVER_ENABLED=true

# Archive-only mode: consult stored OCR archives without vllm-paddleocr and
# without reserving a GPU. The launchers (`-ArchiveOnly` / `--archive-only`
# force it for one run) merge compose.archive-only.yml, which parks
# vllm-paddleocr, drops the GPU reservation of ocr-api and sets this value
# inside the API container: /parse, /ocr and /parse/chunks answer 503
# `ocr_disabled_archive_only`, autotune and the vLLM poll never run, and
# /health reports mode=archive_only with vllm=disabled. It requires both
# OCR_STORAGE_ENABLED and OCR_STORAGE_BROWSER_ENABLED to be true (sections 12
# and 13). Running `docker compose up` directly ignores this switch too.
OCR_ARCHIVE_ONLY=false

# =============================================================================
# 02 | Published host ports (always 127.0.0.1 in Compose)
# =============================================================================

# Host loopback ports published by Compose. Internal container-to-container
# ports remain fixed (ocr-api on 8020, vllm-paddleocr on 8080, storage-gateway
# on 8333 and 23646). Valid range for all ports: 1..65535.

# Host port for the OCR FastAPI server and built-in web console (127.0.0.1).
OCR_SERVER_PORT=8020

# Host port exposing the vLLM OpenAI-compatible API and /docs on 127.0.0.1.
OCR_VLLM_DOCS_PORT=8081

# Host and internal listener port for the MCP HTTP transport (127.0.0.1).
MCP_PORT=8021

# Host port for the nginx S3 storage gateway when the `storage` profile is active.
OCR_S3_PORT=8333

# Host port for the read-only SeaweedFS storage console via storage-gateway.
OCR_STORAGE_CONSOLE_PORT=23646

# =============================================================================
# 03 | API and MCP authentication
# =============================================================================

# Inbound bearer credentials for ocr-api and its web console, as a
# comma-separated `token:label` list (same format as MCP_API_TOKENS). The label
# only names the credential in the startup log; clients send the token half
# alone as `Authorization: Bearer <token>`, and the console's API key field
# takes the token half alone. Tokens and labels must be unique; labels must
# match `[A-Za-z0-9._-]+`. Revoke one person by deleting their entry and
# restarting ocr-api. Replaces the former single-value OCR_SERVER_API_TOKEN,
# which preflight and ocr-api now refuse.
# Empty disables authentication on ocr-api so `/parse`, `/ocr`, `/chunk`,
# `/stats` and `/metrics` are reachable on 127.0.0.1 without an Authorization
# header. When set, every route except `/`, `/health`, `/assets/*` and (when
# enabled) Swagger UI requires a bearer token.
# Example format: api-secret-1:alice,api-secret-2:bob
OCR_SERVER_API_TOKENS=

# Inbound bearer credentials for ocr-mcp, as a comma-separated `token:label`
# list. Both tokens and labels must be unique; labels must match
# `[A-Za-z0-9._-]+` and must not start with `@`. Every token here MUST be
# distinct from OCR_SERVER_API_TOKENS and UPSTREAM_CLIENT_TOKEN so a single
# credential cannot open both services.
# REQUIRED when MCP_SERVER_ENABLED=true: an empty value fails preflight and
# prevents the MCP container from starting.
# Example format: mcp-secret-1:claude,mcp-secret-2:codex
MCP_API_TOKENS=

# Service credential: one plain token (no `:label`) that ocr-mcp presents when
# calling ocr-api. ocr-api accepts it automatically under the label `@mcp`, so
# it does NOT go in OCR_SERVER_API_TOKENS -- set it once here and it works at
# both ends. Host-side live verifiers, benchmark.py and the live Playwright
# suites send it too. REQUIRED when OCR_SERVER_API_TOKENS is non-empty and the
# MCP server is enabled; ignored by ocr-api while OCR_SERVER_API_TOKENS is empty.
UPSTREAM_CLIENT_TOKEN=

# =============================================================================
# 04 | Console, documentation and browser access
# =============================================================================

# Expose the interactive OpenAPI routes (`/docs`, `/redoc`, `/openapi.json`) on
# ocr-api. These routes remain public even when OCR_SERVER_API_TOKENS is set.
EXPOSE_OCR_SWAGGER=true

# Serve the static browser console (`frontend/dist/`) at `/` and `/assets/*`.
# Can be overridden per run with `-Frontend` / `-NoFrontend` (`--frontend` / `--no-frontend`).
EXPOSE_FRONTEND=true

# Comma-separated CORS `Access-Control-Allow-Origin` allowlist for ocr-api.
# Empty disables CORS headers completely. Include `null` only if opening a
# standalone `file://` UI that calls the loopback API; prefer explicit origins
# over `*`.
OCR_CORS_ORIGINS=

# Comma-separated Host header allowlist for ocr-mcp HTTP requests. Empty uses
# the built-in loopback defaults (the bind host, `127.0.0.1` and `localhost`,
# with and without MCP_PORT). Setting a list replaces the defaults completely.
MCP_ALLOWED_HOSTS=

# Comma-separated Origin header allowlist for browser-based MCP clients. Empty
# rejects all browser Origin headers by default.
MCP_ALLOWED_ORIGINS=

# =============================================================================
# 05 | API: admission, memory, uploads, timeouts and rate limiting
# =============================================================================

# Maximum queued `/parse` and `/parse/chunks` document jobs waiting for an
# execution slot before ocr-api rejects new requests with 503 `queue_full`.
# Positive integer >= 1.
OCR_MAX_QUEUE_SIZE=16

# Maximum concurrent single-image `/ocr` element recognition requests before
# rejecting with 503 `slots_full`. Positive integer >= 1.
OCR_ELEMENT_MAX_SLOTS=32

# Shared estimated in-memory byte budget for decoded images and working copies
# across active `/ocr` element requests (536870912 = 512 MiB). Requests that
# would exceed this budget return 503 `memory_pressure`.
OCR_ELEMENT_MEMORY_BYTES=536870912

# End-to-end HTTP request timeout in seconds for a document `/parse` job.
# Must be a finite number > 0.
OCR_REQUEST_TIMEOUT=600

# Per-page OCR timeout in seconds inside a multi-page `/parse` job.
# Must be a finite number > 0.
OCR_PAGE_TIMEOUT=120

# Maximum raw upload size in bytes accepted by ocr-api (31457280 = 30 MiB).
# Exceeding this limit returns 413 `file_too_large`. Keep aligned with
# MCP_MAX_FILE_BYTES in section 11.
MAX_FILE_BYTES=31457280

# Maximum decoded byte size for a single embedded image extracted during layout
# processing (20971520 = 20 MiB).
OCR_MAX_EMBEDDED_IMAGE_BYTES=20971520

# Maximum page count accepted for a single PDF or multi-frame image document.
# Documents with more pages are rejected before inference.
OCR_MAX_PAGES=50

# Per-client IP token-bucket rate limit in requests per minute. Set to 0 to
# disable rate limiting completely. `GET /stats` and `GET /metrics` are exempt
# so console polling does not consume the budget.
OCR_RATE_LIMIT_REQUESTS_PER_MINUTE=3600

# Maximum instantaneous burst capacity per client IP before rate limiting
# returns 429 `rate_limited`. Positive integer >= 1.
OCR_RATE_LIMIT_BURST_SIZE=120

# Maximum tracked client IP buckets kept in LRU memory. Positive integer >= 1.
OCR_RATE_LIMIT_MAX_CLIENTS=10000

# Idle seconds after which a fully replenished client bucket is eligible for
# eviction. Must be > 0.
OCR_RATE_LIMIT_IDLE_SECONDS=600

# =============================================================================
# 06 | PDF: rasterization and per-page pixel budget
# =============================================================================

# Default PDF rendering resolution in dots per inch when a `/parse` request
# omits `dpi`. Accepted range: 50..400.
OCR_PARSE_DPI=250

# Maximum rasterized pixels (`width * height`) allowed for a single PDF page
# (25000000 = 25 MP). Exceeding the budget returns 413 without silent downscaling.
OCR_PDF_MAX_PAGE_PIXELS=25000000

# =============================================================================
# 07 | Office/OpenDocument conversion through LibreOffice
# =============================================================================

# Enable `/office/pdf` and automatic Office/ODF (`.docx`, `.pptx`, `.xlsx`,
# `.doc`, `.ppt`, `.xls`, `.odt`, `.odp`, `.ods`) to PDF conversion in `/parse`.
OCR_OFFICE_ENABLED=true

# Optional explicit path to the LibreOffice `soffice` binary inside the
# container. Leave empty to resolve `soffice` / `libreoffice` from the
# container PATH (never put a Windows host path here when running in Docker).
OCR_SOFFICE_PATH=

# Maximum seconds allowed for a single headless LibreOffice conversion before
# aborting with 422 `office_conversion_timeout`.
OCR_OFFICE_TIMEOUT_SECONDS=120

# =============================================================================
# 08 | Hardware autotuning and OCR pipeline concurrency
# =============================================================================

# Pre-start calibration mode run by `autotune_entrypoint.py`:
# `off` skips calibration and uses API defaults/manual overrides; `quick`
# probes VL concurrency; `full` also screens layout threads and confirms contenders.
OCR_AUTOTUNE=quick

# Optimization objective used when ranking valid calibration candidates:
# `balanced`, `latency`, or `throughput`.
OCR_TUNING_OBJECTIVE=balanced

# When true, discard any cached autotune profile in `ocr-autotune-profile` and
# recalibrate from scratch on container start.
OCR_AUTOTUNE_FORCE=false

# Calibration admission budget in seconds, checked between passes. Empty uses
# 600 seconds in quick mode or 1200 in full mode. Running native work can overrun.
OCR_AUTOTUNE_MAX_SECONDS=

# Docker Compose healthcheck `start_period` for `ocr-api`, giving first-run
# model downloads and startup calibration time to complete (`vllm-paddleocr`
# keeps a fixed 600s).
OCR_HEALTH_START_PERIOD=1500s

# Manual overrides for PaddleOCR pipeline concurrency. Leave empty so the
# calibrated hardware profile (or API defaults) selects them automatically.
# Explicit lane/thread overrides are held fixed during calibration:
# - OCR_VL_LANES: concurrent VL recognition workers
# - OCR_PAGE_PARALLELISM: only 1 supported (serial, non-thread-safe predictor)
# - OCR_LAYOUT_THREADS: Paddle CPU threads (pre/post-processing; the
#   PP-DocLayoutV3 network itself runs on the GPU)
OCR_VL_LANES=
OCR_PAGE_PARALLELISM=
OCR_LAYOUT_THREADS=

# CPU limit of the ocr-api container (rasterization, Office conversion,
# chunking; layout analysis runs on the GPU). Positive number, at most the
# host's CPU count (Docker refuses to start the container otherwise).
OCR_API_CPUS=4.0

# VRAM cap in MiB for PP-DocLayoutV3 layout analysis, which runs on the GPU in
# ocr-api next to vLLM. Positive integer; the queued PaddleOCR-VL pipeline
# peaks at about 3.1 GB on 16-page blocks at 250 DPI (3072 runs out of memory).
# Raise it with OCR_PARSE_DPI or the pixel budgets. Needs an 8 GB card at least;
# on 8 GB cards restart vllm-paddleocr and ocr-api together, because layout
# keeps its VRAM and a lone vLLM restart may not find room for its KV cache.
OCR_LAYOUT_GPU_MEMORY_MB=3584

# Shared API admission slots, capped by OCR_VLLM_MAX_NUM_SEQS. Positive integer.
# Each /ocr call uses one slot; each native parsing worker uses one slot but
# can dispatch OCR_VL_LANES block requests. This is not a global VL-request cap.
OCR_VL_MAX_INFLIGHT=16

# =============================================================================
# 09 | vLLM: image, model, cache and GPU overrides
# =============================================================================

# Container image tag used by `vllm-paddleocr`. The default tag is built locally
# from `Dockerfile.vllm` on top of the digest-pinned upstream `vllm/vllm-openai`
# image; setting a custom tag causes the launcher to pull rather than build it.
OCR_VLLM_IMAGE=ocr-vllm:0.32.0-security

# Served model alias and immutable Hugging Face commit revision shared by
# `vllm-paddleocr` and `ocr-api`. Leave empty to use `PaddleOCR-VL-0.9B` and
# the verified revision `c5630abae1d940eafe0697512a0325494b02ab42`.
OCR_VLLM_SERVED_MODEL_NAME=
OCR_VLLM_MODEL_REVISION=

# Read-only Hugging Face cache mount inside `ocr-api` used by the local Paddle
# tokenizer during deterministic RAG chunking.
OCR_HF_CACHE_DIR=/app/model_cache/hf

# Docker/NVIDIA index (usually the `nvidia-smi` order) of the one GPU reserved
# by both `vllm-paddleocr` and `ocr-api`. Empty selects GPU 0. Override per run
# with `-GpuDevice <index>` (`--gpu-device <index>`); apply a change with `up`.
OCR_GPU_DEVICE=

# Low-level vLLM GPU overrides. Leave empty so `vllm/stage1_entrypoint.py`
# selects tier-appropriate values for the detected NVIDIA GPU:
# - OCR_VLLM_GPU_MEM_UTIL: fraction of VRAM reserved by vLLM (0.0, 1.0]
# - OCR_VLLM_MAX_NUM_SEQS: max concurrent sequences (tier default, or 16 on API)
# - OCR_VLLM_ENFORCE_EAGER: disable CUDA graphs when true
OCR_VLLM_GPU_MEM_UTIL=
OCR_VLLM_MAX_NUM_SEQS=
OCR_VLLM_ENFORCE_EAGER=

# Additional vLLM token and multimodal processor cache overrides. Leave empty
# for defaults (16384 batched tokens, 16384 max model length, 0 GiB MM cache).
OCR_VLLM_MAX_NUM_BATCHED_TOKENS=
OCR_VLLM_MAX_MODEL_LEN=
OCR_VLLM_MM_PROCESSOR_CACHE_GB=

# Keep `0` to use the V1 model runner compatible with Docker Desktop / WSL 2;
# the V2 runner requires CUDA Unified Virtual Addressing (UVA).
OCR_VLLM_USE_V2_MODEL_RUNNER=0

# =============================================================================
# 10 | RAG: chunking CPU, token, memory and output limits
# =============================================================================

# Admission and complexity bounds for deterministic CPU RAG chunking (`/chunk`,
# `/parse/chunks`, and manual refinement). These guards are independent of GPU
# OCR capacity.

# Maximum UTF-8 byte size of the JSON input payload accepted by `/chunk` (32 MiB).
OCR_CHUNK_MAX_INPUT_BYTES=33554432

# Maximum layout blocks accepted in a single chunking request.
OCR_CHUNK_MAX_BLOCKS=20000

# Maximum atomic structural units produced during block decomposition.
OCR_CHUNK_MAX_UNITS=20000

# Hard ceiling on `options.max_tokens` per chunk (32768 tokens).
OCR_CHUNK_MAX_TOKENS=32768

# Maximum dynamic-programming graph edges evaluated during optimal splitting.
OCR_CHUNK_MAX_DP_EDGES=320000

# Maximum candidate split evaluations allowed per request.
OCR_CHUNK_MAX_SPLIT_EVALUATIONS=100000

# Maximum tokenizer invocations allowed across a single chunking job.
OCR_CHUNK_MAX_TOKEN_EVALUATIONS=1100000

# Maximum cumulative rendered Markdown bytes during candidate assembly (256 MiB).
OCR_CHUNK_MAX_RENDERED_BYTES=268435456

# Maximum total table cells processed across all tables in a chunking request.
OCR_CHUNK_MAX_TABLE_CELLS=100000

# Maximum number of output chunks a single job may emit.
OCR_CHUNK_MAX_OUTPUT_CHUNKS=10000

# Maximum serialized UTF-8 byte size of the chunking response (64 MiB).
OCR_CHUNK_MAX_OUTPUT_BYTES=67108864

# Worker process/thread pool size dedicated to CPU chunking jobs.
OCR_CHUNK_MAX_WORKERS=2

# Per-job execution timeout in seconds for CPU chunking and refinement.
OCR_CHUNK_TIMEOUT_SECONDS=120

# Maximum seconds a chunking request waits for a busy worker slot before
# rejecting with 503.
OCR_CHUNK_QUEUE_WAIT_SECONDS=0.5

# =============================================================================
# 11 | MCP: timeouts, retries, size limits and local file access
# =============================================================================

# Upstream HTTP timeout in seconds for standard OCR inference tool calls. Keep
# above OCR_REQUEST_TIMEOUT (600s) so the API's own timeout surfaces cleanly.
MCP_HTTP_TIMEOUT=660

# Total upstream HTTP deadline in seconds for RAG chunking tool calls. Keep at
# or above `OCR_REQUEST_TIMEOUT + OCR_CHUNK_TIMEOUT_SECONDS + 30` (750s default).
MCP_CHUNK_HTTP_TIMEOUT=780

# Maximum UTF-8 byte size of arguments passed to MCP chunking tools (8 MiB),
# checked both before and after local source/base64 preparation.
MCP_CHUNK_MAX_ARGUMENT_BYTES=8388608

# Maximum serialized byte size of an MCP RAG tool result, storage download, or
# Office PDF preview (8 MiB; minimum 1024 bytes). Oversized outputs fail closed
# with `mcp_output_limit` and a REST recovery route instead of truncating.
MCP_CHUNK_MAX_RESULT_BYTES=8388608

# Total deadline in seconds for diagnostic `GET` probes (`/health`, `/stats`,
# `/metrics`), including all retries and backoff.
MCP_DIAGNOSTIC_TIMEOUT=5

# Timeout in seconds for storage list/detail calls or a single archive download.
MCP_STORAGE_TIMEOUT=150

# Maximum attempts for idempotent diagnostic/storage `GET` requests within their
# timeout budget. Inference `POST` requests are never retried.
MCP_RETRY_ATTEMPTS=3

# Initial retry backoff in seconds (with jitter) for retryable MCP `GET` calls.
MCP_RETRY_BACKOFF_SECONDS=0.5

# Semicolon-separated list of server-visible directories from which `ocr-mcp`
# may read local files by path. Empty disables server-side path inputs (base64
# inputs still work). In Docker, also mount the host directory read-only into
# `ocr-mcp` via a Compose override.
MCP_INPUT_ROOTS=

# Maximum decoded input file size in bytes accepted by `ocr-mcp` (30 MiB). Keep
# aligned with MAX_FILE_BYTES in section 05.
MCP_MAX_FILE_BYTES=31457280

# =============================================================================
# 12 | S3/SeaweedFS archive: activation, retention and limits
# =============================================================================

# Enable automatic S3 archiving of OCR outputs in `ocr-api`. Run
# `python scripts/configure_storage.py` first to populate section 13 credentials
# and enable the `storage` Compose profile.
OCR_STORAGE_ENABLED=false

# Enable the `/storage/*` API routes, the console STORAGE tab, and MCP storage
# browsing and whole-archive deletion tools (requires OCR_S3_BROWSER_* credentials
# in section 13). Single-file deletion and RAG refinement also need
# OCR_STORAGE_ENABLED.
OCR_STORAGE_BROWSER_ENABLED=false

# Internal S3 endpoint reached by `ocr-api` over the Compose network. Host-side
# tools use `http://127.0.0.1:<OCR_S3_PORT>`.
OCR_S3_ENDPOINT=http://storage-gateway:8333

# S3 bucket name provisioned by `storage-init` and used for OCR archives.
OCR_S3_BUCKET=ocr-outputs

# S3 signing region and addressing style (`path` or `virtual`) for boto3.
OCR_S3_REGION=us-east-1
OCR_S3_ADDRESSING_STYLE=path

# Automatic archive retention in days applied by `storage-init` (`0` disables
# expiration; must be a non-negative integer).
OCR_S3_RETENTION_DAYS=30

# Per-operation S3 client timeout in seconds and maximum concurrent storage
# operations in `ocr-api`.
OCR_STORAGE_TIMEOUT_SECONDS=10
OCR_STORAGE_MAX_INFLIGHT=2

# Maximum archive size in bytes (128 MiB) and maximum objects per archive job.
# Every parsed page adds one Markdown object and a second copy of its Markdown
# bytes (`document/<stem>_pNNNN.md`) on top of its figure crops.
OCR_STORAGE_MAX_BYTES=134217728
OCR_STORAGE_MAX_OBJECTS=1024

# Whether to archive the original input document (`OCR_STORAGE_SAVE_INPUT`) and,
# in `/parse/chunks` archives, the pre-chunking `/parse` result as `parsed.json`
# (`OCR_STORAGE_SAVE_PARSED`). `/parse` archives always keep their JSON and Markdown.
OCR_STORAGE_SAVE_INPUT=false
OCR_STORAGE_SAVE_PARSED=true

# =============================================================================
# 13 | Storage secrets: separate identities by privilege
# =============================================================================

# Generated in `.env` by `python scripts/configure_storage.py`. Leave all ten
# variables empty in `.env.example`. When the `storage` profile is enabled,
# `scripts/verify_token_config.py` requires all four S3 key pairs to be present
# and pairwise distinct.

# S3 admin identity: used only by SeaweedFS and `storage-init`, never passed to
# `ocr-api` or `ocr-mcp`.
OCR_S3_ADMIN_ACCESS_KEY=
OCR_S3_ADMIN_SECRET_KEY=

# API writer identity: used by `ocr-api` to list and write job archives.
OCR_S3_ACCESS_KEY=
OCR_S3_SECRET_KEY=

# External reader identity: least-privilege read/list key for external consumers.
OCR_S3_READER_ACCESS_KEY=
OCR_S3_READER_SECRET_KEY=

# API browser identity: used by `ocr-api` `/storage/*` routes to list, download
# and (with confirmation) delete archives.
OCR_S3_BROWSER_ACCESS_KEY=
OCR_S3_BROWSER_SECRET_KEY=

# SeaweedFS web console passwords for the admin and read-only console accounts.
OCR_SEAWEED_ADMIN_PASSWORD=
OCR_SEAWEED_READER_PASSWORD=

# =============================================================================
# 14 | Native startup: options NOT forwarded by Compose
# =============================================================================

# Commented assignments below document native (non-Docker) execution. In
# Compose, internal service URLs, listener addresses and unauthenticated flags
# are hardcoded in `compose.yml`. Keep these lines commented so
# `guide/environment.html` records them as optional native settings.
#
# When running `ocr_mcp` natively from source against an authenticated API, set
# UPSTREAM_CLIENT_TOKEN in section 03 in its environment as well.
# MCP_UPSTREAM_URL=http://127.0.0.1:8020
# MCP_BIND_HOST=127.0.0.1
# MCP_LISTEN_HOST=127.0.0.1
# MCP_ALLOW_UNAUTHENTICATED_LOCAL=false
#
# When running `ocr_server.py` natively on the host against a containerized
# vLLM service, export these in your shell before starting Uvicorn:
# OCR_VLLM_URL=http://127.0.0.1:8081/v1
# OCR_VLLM_SERVED_MODEL=PaddleOCR-VL-0.9B
