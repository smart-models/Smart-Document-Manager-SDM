# Line-ending contract for the repository.
#
# Without this file the checkout depends on each author's core.autocrlf, which
# can leave stack.sh in the working tree with CRLF endings: a shell script with
# CRLF fails at the shebang with "bad interpreter: ...^M".
#
# Source and configuration files are normalised to LF in the index and working
# tree so the same clone works identically on Windows and on Unix/containers.

* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
Dockerfile text eol=lf
Dockerfile.vllm text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Preserve binary assets byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.tif binary
*.docx binary
*.woff2 binary
